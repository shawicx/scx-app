{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "scx-app",
  "version": "0.1.0",
  "identifier": "com.scx-app.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "security": {
      "csp": null
    },
    "windows": [
      {
        "title": "scx-app",
        "width": 800,
        "height": 600
      }
    ]
  },
  "plugins": {
    "fs": {
      "scope": [
        "**"
      ]
    },
    "protocol": {
      "assetScope": [
        "**"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
